      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        }
      }
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Entradas maliciosas detectadas (5 min)",
      "description": "Patrones de SQLi / XSS / SSTI en formularios",
